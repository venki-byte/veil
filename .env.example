# Copy this file to .env and fill in the values from the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
# These values identify the project; they are not secrets, but .env is still
# kept out of git. The Gemini API key is never in this app: Firebase AI Logic holds it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check.
# On localhost the debug provider is used automatically: the browser console
# prints a debug token that you register under Security > App Check > Apps > Manage debug tokens.
# For the hosted site set ONE of these site keys. reCAPTCHA v3 is free and needs no billing;
# reCAPTCHA Enterprise may require a billing account.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_RECAPTCHA_V3_SITE_KEY=

# Optional, for local testing: cloud model used for explanations and follow-ups.
# Leave empty to use Remote Config (model_name) or the default in src/config/settings.ts.
VITE_CLOUD_MODEL=
